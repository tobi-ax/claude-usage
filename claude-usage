PRICING_SOURCE_URL = "https://platform.claude.com/docs/en/about-claude/pricing.md"
PRICING_FETCH_TIMEOUT = 20


def default_pricing_path():
    base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return os.path.join(base, "claude-usage", "pricing.json")


def load_pricing_file(path):
    if not os.path.exists(path):
        return None
    with open(path, encoding="utf-8") as fh:
        try:
            return json.load(fh)
        except ValueError:
            return None


def load_fetched_pricing(path):
    doc = load_pricing_file(path)
    return doc if doc and isinstance(doc.get("models"), dict) else None


def save_pricing_file(path, doc):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(doc, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)


def fetch_pricing_markdown(url, timeout):
    req = urllib.request.Request(url, headers={"User-Agent": "claude-usage"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read().decode("utf-8", errors="replace")


def extract_price(cell):
    """The first $amount in a table cell, ignoring a footnote digit glued to the unit."""
    m = re.search(r"\$\s*([\d.]+)", cell)
    return float(m.group(1)) if m else None


def model_id_from_name(name):
    """API model id for a display name, e.g. Claude Opus 4.1 (retired...) -> claude-opus-4-1."""
    label = name.split("(")[0].strip()
    return re.sub(r"[ .]", "-", label.lower())


def table_rows(text):
    """Cell lists of the first markdown table whose header has "Base input tokens"."""
    lines = text.splitlines()
    header = next((i for i, l in enumerate(lines) if l.strip().startswith("|") and "Base input tokens" in l), None)
    if header is None:
        return []
    data = takewhile(lambda l: l.strip().startswith("|"), lines[header + 2:])
    return [[c.strip() for c in l.strip().strip("|").split("|")] for l in data]


def price_row(cells):
    """One table row -> (model id, rates), or None for a non-model or incomplete row."""
    name = cells[0] if cells else ""
    if not name.startswith("Claude ") or len(cells) < 6:
        return None
    prices = [extract_price(c) for c in cells[1:6]]
    if any(p is None for p in prices):
        return None
    input_rate, write5, write1, read, output = prices
    return model_id_from_name(name), {
        "input": input_rate, "cache_write_5m": write5, "cache_write_1h": write1,
        "cache_read": read, "output": output,
    }


def parse_pricing_table(text):
    return dict(r for r in map(price_row, table_rows(text)) if r is not None)


def pricing_diff(old, new):
    """(added, removed, changed) model ids between two id -> rates dicts."""
    added = sorted(set(new) - set(old))
    removed = sorted(set(old) - set(new))
    changed = sorted(k for k in set(old) & set(new) if old[k] != new[k])
    return added, removed, changed


def build_update_parser():
    return argparse.ArgumentParser(
        prog="claude-usage update",
        description="Fetch current Claude model prices from Anthropic's pricing page and store them "
                     "at {} for future reports.".format(display_path(default_pricing_path())))


def run_update(argv):
    build_update_parser().parse_args(argv)
    try:
        text = fetch_pricing_markdown(PRICING_SOURCE_URL, PRICING_FETCH_TIMEOUT)
    except urllib.error.HTTPError as e:
        print("could not fetch {}: HTTP {} {}".format(PRICING_SOURCE_URL, e.code, e.reason), file=sys.stderr)
        return 1
    except (urllib.error.URLError, OSError) as e:
        print("could not fetch {}: {}".format(PRICING_SOURCE_URL, getattr(e, "reason", e)), file=sys.stderr)
        return 1
    models = parse_pricing_table(text)
    if len(models) < 5:
        print("only {} model(s) parsed from {}, expected a pricing table with 'Base input tokens'; "
              "not writing anything".format(len(models), PRICING_SOURCE_URL), file=sys.stderr)
        return 1
    pricing_path = default_pricing_path()
    previous = load_fetched_pricing(pricing_path)
    baseline = previous["models"] if previous else PRICING
    fetched_at = datetime.now().astimezone().isoformat(timespec="seconds")
    save_pricing_file(pricing_path, {"fetched_at": fetched_at, "source": PRICING_SOURCE_URL, "models": models})
    added, removed, changed = pricing_diff(baseline, models)
    print("Fetched {} models from {} at {}".format(len(models), PRICING_SOURCE_URL, fetched_at))
    if added:
        print("  new: {}".format(", ".join(added)))
    if removed:
        print("  removed: {}".format(", ".join(removed)))
    if changed:
        print("  changed: {}".format(", ".join(changed)))
    if not (added or removed or changed):
        print("  no changes from the prices in effect before this update")
    print("  saved to {}".format(display_path(pricing_path)))
    return 0


# --------------------------------------------------------------------------
# Import of Claude Code's own stats cache (approximate history)
# --------------------------------------------------------------------------

def split_by_share(total, shares):
    """Integers summing to total, one per share; rounding drift lands on the last."""
    if not shares:
        return []
    head = [int(total * s) for s in shares[:-1]]
    return head + [total - sum(head)]


def stats_cache_rows(cache, machine_name):
    """One approximate row per (day, model).

    The cache stores exact per-model totals (input, output, cache write,
    cache read) for its whole period, and per day only input+output per
    model. Each model's totals are spread over its days by that day's share
    of input+output. Totals per model stay exact; the per-day split is an
    estimate. The 5 min / 1 h cache write split is not recorded, so every
    write is priced at the cheaper 5 min rate. The rows carry n=0 so they do
    not count as API calls.
    """
    totals = cache.get("modelUsage") or {}
    daily = cache.get("dailyModelTokens") or []
    fallback_day = cache.get("lastComputedDate") or "1970-01-01"

    def rows_for(model):
        u = totals[model]
        days = [(d["date"], d["tokensByModel"][model]) for d in daily if model in (d.get("tokensByModel") or {})]
        days = days if sum(n for _, n in days) > 0 else [(fallback_day, 1)]
        denom = sum(n for _, n in days)
        shares = [n / denom for _, n in days]
        parts = {
            "i": split_by_share(u.get("inputTokens") or 0, shares),
            "o": split_by_share(u.get("outputTokens") or 0, shares),
            "w5": split_by_share(u.get("cacheCreationInputTokens") or 0, shares),
            "r": split_by_share(u.get("cacheReadInputTokens") or 0, shares),
        }
        return [{
            "id": "stats-cache:%s:%s:%s" % (machine_name, date, model), "rq": "",
            "t": date + "T12:00:00.000Z", "m": model,
            "i": parts["i"][idx], "o": parts["o"][idx], "w5": parts["w5"][idx], "w1": 0, "r": parts["r"][idx],
            "f": 0, "e": IMPORTED_ENTRYPOINT, "s": "", "p": "", "n": 0, "mach": machine_name,
        } for idx, (date, _) in enumerate(days)]

    return [r for m in totals for r in rows_for(m) if any(r[k] for k in TOKEN_KEYS)]


def run_import(args, cfg):
    path = os.path.expanduser(args.import_stats_cache)
    if not os.path.exists(path):
        raise SystemExit("stats cache not found: %s" % path)
    with open(path, encoding="utf-8") as fh:
        cache = json.load(fh)
    machine_name = args.import_machine or platform.node()
    warehouse_path = os.path.expanduser(args.warehouse or cfg.get("warehouse") or default_warehouse_path())
    stored = load_warehouse(warehouse_path)
    live = local_machine(args.projects_dir)["rows"] if machine_name == platform.node() else []
    real = [r for r in stored + live if r.get("mach") == machine_name and not is_imported(r)]
    cutoff = min(r["t"][:10] for r in real) if real else None
    candidates = stats_cache_rows(cache, machine_name)
    imported = [r for r in candidates if cutoff is None or r["t"][:10] < cutoff]
    merged, _ = merge_into_warehouse(warehouse_path, stored, live + imported)
    dates = sorted(r["t"][:10] for r in imported)
    print("Imported {:,} approximate model-day rows for {} from {}".format(len(imported), machine_name, path))
    if imported:
        print("  period {} to {}, models: {}".format(dates[0], dates[-1], ", ".join(sorted({r["m"] for r in imported}))))
    if cutoff:
        print("  skipped {:,} rows on or after {} (real transcript data exists from there)".format(
            len(candidates) - len(imported), cutoff))
    print("  warehouse now holds {:,} rows at {}".format(len(merged), display_path(warehouse_path)))
    return 0


# --------------------------------------------------------------------------
# Pricing and summaries
# --------------------------------------------------------------------------

def price_key(model, pricing):
    base = re.sub(r"-\d{8}$", "", model)
    if base in pricing:
        return base
    return next((k for k in sorted(pricing, key=len, reverse=True) if base.startswith(k + "-")), None)


def row_cost(r, pricing):
    key = price_key(r["m"], pricing)
    if key is None:
        return None
    rates = pricing[key]
    mult = FAST_MODE_MULTIPLIER if r.get("f") and key in FAST_MODE_MODELS else 1.0
    raw = (r["i"] * rates["input"] + r["o"] * rates["output"] + r["r"] * rates["cache_read"]
           + r["w5"] * rates["cache_write_5m"] + r["w1"] * rates["cache_write_1h"])
    return mult * raw / 1e6


def normalize_pricing_entry(v):
    """Accept the five-rate dict shape, or the legacy [input, output, cache_read] list."""
    if isinstance(v, dict):
        return v
    input_rate, output_rate, cache_read_rate = v
    return derive_rates(input_rate, output_rate, cache_read_rate)


def empty_summary():
    return {**{k: 0 for k in TOKEN_KEYS}, "calls": 0, "cost": 0.0, "unpriced": 0}


def summarize(rows, pricing):
    def add(acc, r):
        c = row_cost(r, pricing)
        return {
            **acc,
            **{k: acc[k] + r[k] for k in TOKEN_KEYS},
            "calls": acc["calls"] + r.get("n", 1),
            "cost": acc["cost"] + (c if c is not None else 0.0),
            "unpriced": acc["unpriced"] + (0 if c is not None else sum(r[k] for k in TOKEN_KEYS)),
        }
    return reduce(add, rows, empty_summary())


def total_tokens(s):
    return sum(s[k] for k in TOKEN_KEYS)


def group(rows, keyfn, pricing):
    return {k: summarize(list(g), pricing) for k, g in groupby(sorted(rows, key=keyfn), key=keyfn)}


def parse_ts(t):
    try:
        return datetime.strptime(t[:19], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc)
    except ValueError:
        return None


def local_bucket(fmt):
    def key(r):
        dt = parse_ts(r["t"])
        return dt.astimezone().strftime(fmt) if dt else "unknown"
    return key


def model_label(r):
    return r["m"] + (" (fast)" if r.get("f") else "")


GROUPINGS = {
    "day": ("Day", local_bucket("%Y-%m-%d")),
    "week": ("Week", local_bucket("%G-W%V")),
    "month": ("Month", local_bucket("%Y-%m")),
    "entrypoint": ("Entrypoint", lambda r: r["e"]),
    "project": ("Project (cwd)", lambda r: r["p"] or "unknown"),
}


# --------------------------------------------------------------------------
# Period selection
# --------------------------------------------------------------------------

def parse_date(s):
    try:
        return datetime.strptime(s, "%Y-%m-%d")
    except ValueError:
        raise SystemExit("dates must be YYYY-MM-DD, got %r" % s)


def last_delta(spec):
    m = re.fullmatch(r"(\d+)([dwm])", spec or "")
    if not m:
        raise SystemExit("--last expects a number and d, w or m, e.g. 7d, 4w, 3m")
    return timedelta(days=int(m.group(1)) * {"d": 1, "w": 7, "m": 30}[m.group(2)])


def period_bounds(args):
    """(since, until) as naive local datetimes; until is exclusive."""
    today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
    since = parse_date(args.since) if args.since else (today - last_delta(args.last) if args.last else None)
    until = parse_date(args.until) + timedelta(days=1) if args.until else None
    return since, until


def to_utc_iso(local_naive):
    return local_naive.astimezone().astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S") if local_naive else None


def in_period(r, since_s, until_s):
    t = r["t"][:19]
    return (since_s is None or t >= since_s) and (until_s is None or t < until_s)


# --------------------------------------------------------------------------
# Rendering
# --------------------------------------------------------------------------

def fmt_tok(n, exact):
    if exact or n < 1000:
        return "{:,}".format(n)
    return next(("{:.1f}{}".format(n / div, suf) for div, suf in ((1e9, "B"), (1e6, "M"), (1e3, "k")) if n >= div), str(n))


def fmt_usd(c):
    return "${:,.2f}".format(c)


def fmt_pct(part, whole):
    return "{:.1f}%".format(100.0 * part / whole) if whole else "-"


def render_table(headers, rows, indent="  "):
    if not rows:
        return indent + "(nothing)"
    widths = [max(len(str(c)) for c in col) for col in zip(headers, *rows)]

    def line(cells):
        return indent + "  ".join(
            str(c).ljust(w) if i == 0 else str(c).rjust(w) for i, (c, w) in enumerate(zip(cells, widths))
        ).rstrip()
    return "\n".join([line(headers), indent + "  ".join("-" * w for w in widths)] + [line(r) for r in rows])


def usage_row(label, s, exact, grand=None):
    base = [label, "{:,}".format(s["calls"]), fmt_tok(s["i"], exact), fmt_tok(s["w5"] + s["w1"], exact),
            fmt_tok(s["r"], exact), fmt_tok(s["o"], exact), fmt_tok(total_tokens(s), exact), fmt_usd(s["cost"])]
    share = [fmt_pct(total_tokens(s), total_tokens(grand)), fmt_pct(s["cost"], grand["cost"])] if grand else []
    return base + share


USAGE_HEADERS = ["Calls", "Input", "Cache write", "Cache read", "Output", "Total", "Cost"]
SHARE_HEADERS = ["Tokens %", "Cost %"]


def usage_table(first_header, groups, exact, grand=None, order=None, limit=None):
    keys = order(groups) if order else sorted(groups)
    keys = keys[:limit] if limit else keys
    headers = [first_header] + USAGE_HEADERS + (SHARE_HEADERS if grand else [])
    return render_table(headers, [usage_row(k, groups[k], exact, grand) for k in keys])


def by_cost_desc(groups):
    return sorted(groups, key=lambda k: (-groups[k]["cost"], -total_tokens(groups[k]), k))


def session_table(rows, pricing, exact, top):
    def key(r):
        return (r["mach"], r["s"])
    real = [r for r in rows if not is_imported(r)]
    groups = group(real, key, pricing)
    firsts = {k: min(r["t"] for r in g) for k, g in groupby(sorted(real, key=key), key=key)}
    cwds = {k: next(iter(g))["p"] for k, g in groupby(sorted(real, key=key), key=key)}
    keys = by_cost_desc(groups)[:top]
    headers = ["Session", "Machine", "Project", "First seen", "Calls", "Total", "Cost"]
    body = [[k[1][:8] or "?", k[0], os.path.basename(cwds[k].rstrip("/")) or cwds[k] or "?",
             local_bucket("%Y-%m-%d")({"t": firsts[k]}), "{:,}".format(groups[k]["calls"]),
             fmt_tok(total_tokens(groups[k]), exact), fmt_usd(groups[k]["cost"])] for k in keys]
    return render_table(headers, body)


def machine_lines(machines):
    def line(m):
        if m["error"]:
            return "  {:<14} FAILED: {}".format(m["name"], m["error"])
        meta = m["meta"]
        node = meta.get("node")
        extra = "  ({})".format(node) if node and node != m["name"] else ""
        missing = "  [projects dir missing: {}]".format(meta.get("projects_dir")) if meta.get("exists") is False else ""
        return "  {:<14} {:>6,} API calls  {:>4} files  {:>5}s{}{}".format(
            m["name"], len(m["rows"]), meta.get("files", 0), meta.get("seconds", "?"), extra, missing)
    return [line(m) for m in machines]


def warehouse_line(info):
    if info is None:
        return "  Warehouse: not used (--no-warehouse)"
    return "  Warehouse: {:,} responses ({} new this run), oldest {}, {}".format(
        info["rows"], "{:+,}".format(info["new"]), info["oldest"] or "-", display_path(info["path"]))


def pricing_source_line(fetched):
    if fetched:
        host = urllib.parse.urlparse(fetched["source"]).netloc or fetched["source"]
        return "  Prices: fetched {} from {}".format(fetched["fetched_at"][:10], host)
    return "  Prices: built-in table ({}); run 'claude-usage update' for current ones".format(BUILTIN_PRICING_AS_OF)


def pricing_source_json(fetched):
    if fetched:
        return {"source": "fetched", "fetched_at": fetched["fetched_at"], "url": fetched["source"]}
    return {"source": "built-in", "as_of": BUILTIN_PRICING_AS_OF}


def imported_line(selected, exact):
    imported = [r for r in selected if is_imported(r)]
    if not imported:
        return None
    dates = sorted(r["t"][:10] for r in imported)
    machines = sorted({r["mach"] for r in imported})
    return ("  Approximate: {} model-day rows imported from Claude's stats cache cover {} to {} on {}"
            " ({} tokens). Exact per model, split across days by share, not counted as API calls.").format(
        len(imported), dates[0], dates[-1], ", ".join(machines),
        fmt_tok(sum(r[k] for r in imported for k in TOKEN_KEYS), exact))


def period_text(selected, since, until):
    if since or until:
        return "{} to {}".format(since.strftime("%Y-%m-%d") if since else "start",
                                 (until - timedelta(days=1)).strftime("%Y-%m-%d") if until else "today")
    if not selected:
        return "no data"
    day = local_bucket("%Y-%m-%d")
    stamps = sorted(day(r) for r in selected)
    return "{} to {} (all data)".format(stamps[0], stamps[-1])


def render_report(ctx):
    machines, selected, pricing, args = ctx["machines"], ctx["selected"], ctx["pricing"], ctx["args"]
    grand = summarize(selected, pricing)
    unpriced_models = sorted({r["m"] for r in selected if price_key(r["m"], pricing) is None})
    out = ["Claude Code usage  ·  {}  ·  {} machine{}".format(
        period_text(selected, ctx["since"], ctx["until"]), len(machines), "" if len(machines) == 1 else "s")]
    out += machine_lines(machines)
    out.append(warehouse_line(ctx["warehouse"]))
    out.append(pricing_source_line(ctx["fetched_pricing"]))
    if ctx["cross_dupes"]:
        out.append("  {:,} responses were present on more than one machine and are counted once.".format(ctx["cross_dupes"]))
    out += [l for l in [imported_line(selected, args.exact)] if l]
    out.append("  Times and day buckets use this machine's local timezone.")
    out.append("")
    out.append("Tokens")
    tok_rows = [[TOKEN_LABELS[k], fmt_tok(grand[k], args.exact), fmt_pct(grand[k], total_tokens(grand))] for k in TOKEN_KEYS]
    tok_rows.append(["Total", fmt_tok(total_tokens(grand), args.exact), "100%" if total_tokens(grand) else "-"])
    out.append(render_table(["Type", "Tokens", "Share"], tok_rows))
    out.append("")
    out.append("  API calls: {:,}".format(grand["calls"]))
    out.append("  Estimated cost at Anthropic API list prices: {}".format(fmt_usd(grand["cost"])))
    out.append("  (what these tokens would cost pay-as-you-go; on a subscription this is not the bill)")
    if unpriced_models:
        out.append("  WARNING: no pricing for {} -> {} tokens excluded from the cost.".format(
            ", ".join(unpriced_models), fmt_tok(grand["unpriced"], args.exact)))
    out.append("")
    out.append("By model")
    out.append(usage_table("Model", group(selected, model_label, pricing), args.exact, grand, by_cost_desc))
    out.append("")
    out.append("By machine")
    out.append(usage_table("Machine", group(selected, lambda r: r["mach"], pricing), args.exact, grand, by_cost_desc))
    for name in args.by:
        out.append("")
        if name == "session":
            out.append("Top {} sessions by cost".format(args.top))
            out.append(session_table(selected, pricing, args.exact, args.top))
        else:
            header, keyfn = GROUPINGS[name]
            time_based = name in ("day", "week", "month")
            out.append("By {}".format(name))
            out.append(usage_table(header, group(selected, keyfn, pricing), args.exact,
                                   None if time_based else grand,
                                   None if time_based else by_cost_desc,
                                   None if time_based else args.top))
    return "\n".join(out)


def summary_json(s):
    return {**{TOKEN_LABELS[k]: s[k] for k in TOKEN_KEYS}, "total": total_tokens(s),
            "calls": s["calls"], "cost_usd": round(s["cost"], 4), "unpriced_tokens": s["unpriced"]}


def render_json(ctx):
    machines, selected, pricing, args = ctx["machines"], ctx["selected"], ctx["pricing"], ctx["args"]
    since, until = ctx["since"], ctx["until"]
    grand = summarize(selected, pricing)
    doc = {
        "generated_at": datetime.now().astimezone().isoformat(timespec="seconds"),
        "period": {"since": since.strftime("%Y-%m-%d") if since else None,
                   "until_inclusive": (until - timedelta(days=1)).strftime("%Y-%m-%d") if until else None},
        "machines": [{"name": m["name"], "calls": len(m["rows"]), "error": m["error"],
                      **{k: m["meta"].get(k) for k in ("files", "seconds", "node", "projects_dir", "python")}} for m in machines],
        "warehouse": ctx["warehouse"],
        "pricing": pricing_source_json(ctx["fetched_pricing"]),
        "cross_machine_duplicates": ctx["cross_dupes"],
        "approximate_rows": sum(1 for r in selected if is_imported(r)),
        "totals": summary_json(grand),
        "unpriced_models": sorted({r["m"] for r in selected if price_key(r["m"], pricing) is None}),
        "by_model": {k: summary_json(v) for k, v in group(selected, model_label, pricing).items()},
        "by_machine": {k: summary_json(v) for k, v in group(selected, lambda r: r["mach"], pricing).items()},
        "by": {name: {("/".join(k) if isinstance(k, tuple) else k): summary_json(v) for k, v in
                      (group(selected, lambda r: (r["mach"], r["s"]), pricing) if name == "session"
                       else group(selected, GROUPINGS[name][1], pricing)).items()} for name in args.by},
    }
    return json.dumps(doc, indent=2)


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------

# Subcommand name -> (one-line help, argv[1:] -> exit code). Dispatched on
# argv[0] in main(), ahead of the report parser below, since argparse
# subparsers and a set of top-level report flags do not mix cleanly.
SUBCOMMANDS = {
    "update": ("fetch current model prices from Anthropic and store them for future reports", run_update),
}


def build_parser():
    subcommands_help = "\n".join("  {:<8} {}".format(name, help_text) for name, (help_text, _) in SUBCOMMANDS.items())
    p = argparse.ArgumentParser(
        prog="claude-usage",
        description="Aggregate Claude Code token usage from this machine and every SSH host in the config.",
        epilog="Subcommands:\n{}\nRun 'claude-usage <subcommand> --help' for details.\n\n"
               "Config file: {} (see the module docstring for its shape).".format(subcommands_help, CONFIG_PATH),
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--since", metavar="YYYY-MM-DD", help="first day to include (local time)")
    p.add_argument("--until", metavar="YYYY-MM-DD", help="last day to include (local time, inclusive)")
    p.add_argument("--last", metavar="N{d,w,m}", help="only the last N days/weeks/months (m = 30 days), e.g. 7d")
    p.add_argument("--by", action="append", default=[], choices=sorted(GROUPINGS) + ["session"],
                   help="add a breakdown; repeatable")
    p.add_argument("--top", type=int, default=15, help="rows to show for project/session/entrypoint breakdowns")
    p.add_argument("--host", action="append", metavar="SSH_HOST",
                   help="SSH host to include; repeatable; replaces the config's host list")
    p.add_argument("--no-local", action="store_true", help="skip this machine")
    p.add_argument("--no-remote", action="store_true", help="skip every SSH host")
    p.add_argument("--config", default=CONFIG_PATH, help="config file (default: %(default)s)")
    p.add_argument("--projects-dir", default=DEFAULT_PROJECTS_DIR,
                   help="transcript folder on this machine (default: %(default)s)")
    p.add_argument("--timeout", type=int, help="seconds to wait per SSH host (default: config or %d)" % DEFAULT_TIMEOUT)
    p.add_argument("--warehouse", metavar="PATH",
                   help="where every seen response is kept (default: config or %s)" % display_path(default_warehouse_path()))
    p.add_argument("--no-warehouse", action="store_true", help="neither read nor update the warehouse; live scans only")
    p.add_argument("--import-stats-cache", metavar="PATH", nargs="?", const=DEFAULT_STATS_CACHE,
                   help="one-off: import Claude's stats-cache.json (default %s) as approximate history "
                        "for days before the oldest real transcript, then exit" % DEFAULT_STATS_CACHE)
    p.add_argument("--import-machine", metavar="NAME", help="machine name for the imported rows (default: this host)")
    p.add_argument("--exact", action="store_true", help="print exact token counts instead of k/M")
    p.add_argument("--json", action="store_true", help="print JSON instead of the text report")
    p.add_argument("--collect", action="store_true", help=argparse.SUPPRESS)
    return p


def main(argv):
    if argv and argv[0] in SUBCOMMANDS:
        _, run = SUBCOMMANDS[argv[0]]
        return run(argv[1:])
    args = build_parser().parse_args(argv)
    if args.collect:
        return run_collect(args)
    cfg = load_config(args.config)
    if args.import_stats_cache:
        return run_import(args, cfg)
    fetched_pricing = load_fetched_pricing(default_pricing_path())
    pricing = {
        **PRICING,
        **(fetched_pricing["models"] if fetched_pricing else {}),
        **{k: normalize_pricing_entry(v) for k, v in (cfg.get("pricing") or {}).items()},
    }
    hosts = [] if args.no_remote else [normalize_host(h) for h in (args.host or cfg.get("hosts") or [])]
    ssh_options = cfg.get("ssh_options") or DEFAULT_SSH_OPTIONS
    timeout = args.timeout or cfg.get("timeout") or DEFAULT_TIMEOUT
    warehouse_path = os.path.expanduser(args.warehouse or cfg.get("warehouse") or default_warehouse_path())
    if args.no_local and not hosts and args.no_warehouse:
        raise SystemExit("nothing to scan: --no-local, no SSH hosts and --no-warehouse")
    source = read_self() if hosts else ""
    with ThreadPoolExecutor(max_workers=len(hosts) + 1) as ex:
        local = [] if args.no_local else [ex.submit(local_machine, args.projects_dir)]
        remote = [ex.submit(fetch_remote, h, source, ssh_options, timeout) for h in hosts]
        machines = [f.result() for f in local + remote]
    all_rows = [r for m in machines for r in m["rows"]]
    live = dedup(all_rows)
    stored = [] if args.no_warehouse else load_warehouse(warehouse_path)
    rows, new = (live, 0) if args.no_warehouse else merge_into_warehouse(warehouse_path, stored, live)
    warehouse = None if args.no_warehouse else {
        "path": warehouse_path, "rows": len(rows), "new": new,
        "oldest": min((r["t"][:10] for r in rows), default=None)}
    since, until = period_bounds(args)
    since_s, until_s = to_utc_iso(since), to_utc_iso(until)
    ctx = {
        "machines": machines, "pricing": pricing, "args": args, "since": since, "until": until,
        "selected": [r for r in rows if in_period(r, since_s, until_s)],
        "cross_dupes": len(all_rows) - len(live), "warehouse": warehouse,
        "fetched_pricing": fetched_pricing,
    }
    print((render_json if args.json else render_report)(ctx))
    failed = [m["name"] for m in machines if m["error"]]
    if failed:
        sys.stdout.flush()
        print("\n{} machine{} could not be read: {}. Totals above are incomplete.".format(
            len(failed), "" if len(failed) == 1 else "s", ", ".join(failed)), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
