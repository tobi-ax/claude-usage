# USD per million tokens, per model: input, output, cache read, and the two
# cache-write rates (5-minute and 1-hour TTL). Anthropic API list prices as
# of BUILTIN_PRICING_AS_OF; `claude-usage update` fetches current rates into
# a pricing.json that a report prefers over this table (see price_key()).
BUILTIN_PRICING_AS_OF = "2026-09"
CACHE_WRITE_5M = 1.25  # multiplier of the input rate, 5-minute cache write TTL
CACHE_WRITE_1H = 2.0  # multiplier of the input rate, 1-hour cache write TTL


def derive_rates(input_rate, output_rate, cache_read_rate):
    return {
        "input": input_rate,
        "cache_write_5m": input_rate * CACHE_WRITE_5M,
        "cache_write_1h": input_rate * CACHE_WRITE_1H,
        "cache_read": cache_read_rate,
        "output": output_rate,
    }


