# --------------------------------------------------------------------------
# Collecting: one machine, one row per API response
# --------------------------------------------------------------------------

def parse_line(line):
    """One transcript line -> usage row, or None if it is not a billable response."""
    try:
        d = json.loads(line)
    except ValueError:
        return None
    if not isinstance(d, dict) or d.get("type") != "assistant":
        return None
    m = d.get("message") or {}
    u = m.get("usage") or {}
    model = m.get("model") or ""
    # "<synthetic>" is Claude Code's own placeholder for rate-limit and error
    # messages; it carries zero usage and no model.
    if not u or not model or model.startswith("<"):
        return None
    w_total = u.get("cache_creation_input_tokens") or 0
    w1 = (u.get("cache_creation") or {}).get("ephemeral_1h_input_tokens") or 0
    row = {
        "id": m.get("id") or d.get("uuid") or "",
        "rq": d.get("requestId") or "",
        "t": d.get("timestamp") or "",
        "m": model,
        "i": u.get("input_tokens") or 0,
        "o": u.get("output_tokens") or 0,
        "w5": max(w_total - w1, 0),
        "w1": w1,
        "r": u.get("cache_read_input_tokens") or 0,
        "f": 1 if u.get("speed") == "fast" else 0,
        "e": d.get("entrypoint") or "unknown",
        "s": d.get("sessionId") or "",
        "p": d.get("cwd") or "",
    }
    return row if any(row[k] for k in TOKEN_KEYS) else None


def rows_of(path):
    with open(path, encoding="utf-8", errors="replace") as fh:
        return [r for r in map(parse_line, fh) if r is not None]


def dedup(rows):
    """One row per API response.

    Claude Code writes one record per content block of a streamed response,
    all with the same message id and request id. Only the last one carries
    the final output token count, so the record with the largest output
    count wins. The same rule folds a response that shows up on two
    machines (a session copied between them) into one, and lets a fresh
    scan update a row the warehouse stored while the response was still
    streaming.
    """
    def keep_final(acc, r):
        k = (r["id"], r["rq"])
        if k not in acc or r["o"] > acc[k]["o"]:
            acc[k] = r
        return acc
    return list(reduce(keep_final, rows, {}).values())


def scan(projects_dir):
    root = os.path.expanduser(projects_dir)
    files = sorted(glob.glob(os.path.join(root, "**", "*.jsonl"), recursive=True))
    rows = dedup(r for f in files for r in rows_of(f))
    return rows, {"files": len(files), "projects_dir": root, "exists": os.path.isdir(root)}


def run_collect(args):
    t0 = time.time()
    rows, meta = scan(args.projects_dir)
    sys.stdout.writelines(json.dumps(r, separators=(",", ":")) + "\n" for r in rows)
    summary = {**meta, "node": platform.node(), "python": platform.python_version(),
               "seconds": round(time.time() - t0, 2)}
    sys.stdout.write(json.dumps({"meta": summary}) + "\n")
    return 0


# --------------------------------------------------------------------------
# Gathering: this machine in-process, every other one over SSH
# --------------------------------------------------------------------------

def machine(name, rows, meta, error=None):
    return {"name": name, "rows": [{**r, "mach": name} for r in rows], "meta": meta, "error": error}


def local_machine(projects_dir):
    t0 = time.time()
    rows, meta = scan(projects_dir)
    return machine(platform.node(), rows, {**meta, "node": platform.node(), "python": platform.python_version(),
                                           "seconds": round(time.time() - t0, 2)})


def normalize_host(h):
    spec = {"ssh": h} if isinstance(h, str) else dict(h)
    if not spec.get("ssh"):
        raise SystemExit("config: every host needs an \"ssh\" target: %r" % (h,))
    return {
        "name": spec.get("name") or spec["ssh"],
        "ssh": spec["ssh"],
        "python": spec.get("python") or "python3",
        "projects_dir": spec.get("projects_dir"),
    }


def parse_json_line(line):
    try:
        return json.loads(line)
    except ValueError:
        return None


def parse_collect_output(name, text):
    objs = [o for o in map(parse_json_line, text.splitlines()) if isinstance(o, dict)]
    metas = [o["meta"] for o in objs if "meta" in o]
    rows = [o for o in objs if "meta" not in o]
    if not metas:
        return machine(name, [], {}, error="collector produced no summary line (stdout: %d lines)" % len(text.splitlines()))
    return machine(name, rows, metas[-1])


def fetch_remote(host, source, ssh_options, timeout):
    remote_cmd = " ".join(
        [host["python"], "-", "--collect"]
        + (["--projects-dir", shlex.quote(host["projects_dir"])] if host["projects_dir"] else [])
    )
    cmd = ["ssh", *ssh_options, host["ssh"], remote_cmd]
    try:
        p = subprocess.run(cmd, input=source, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return machine(host["name"], [], {}, error="timed out after %ss" % timeout)
    except OSError as e:
        return machine(host["name"], [], {}, error=str(e))
    if p.returncode != 0:
        tail = p.stderr.strip().splitlines()
        return machine(host["name"], [], {}, error=tail[-1] if tail else "ssh exited with %d" % p.returncode)
    return parse_collect_output(host["name"], p.stdout)


